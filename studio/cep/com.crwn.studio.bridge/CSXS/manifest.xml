<?xml version="1.0" encoding="UTF-8"?>
<!-- CRWN Studio Bridge: lets the Studio page place a JSX in Premiere without F5 in VS Code.
     Unsigned, so it loads only with PlayerDebugMode=1 (studio/cep/install.ps1 sets it). -->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.crwn.studio" ExtensionBundleVersion="1.0.0"
  ExtensionBundleName="CRWN Studio Bridge" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.crwn.studio.bridge" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.crwn.studio.bridge">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>CRWN Studio Bridge</Menu>
          <Geometry>
            <Size>
              <Height>220</Height>
              <Width>340</Width>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
