# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated by npm run preview:emails, for reviewing nurture copy locally.
nurture-preview.html
platform-emails-preview.html

# Video pipeline (scripts/video): rendered jobs are large binaries; music is
# founder-original audio (with Dropbox `name:com.dropbox.attrs` junk entries that
# Windows git cannot even check out). Neither belongs in history.
/videos/output/
/videos/music/
