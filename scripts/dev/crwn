#!/usr/bin/env bash
# crwn: one Claude Code session per task, each in its own git worktree and branch.
# Operating guide: docs/PARALLEL_CLAUDE_SESSIONS.md
#
#   crwn <task> [claude args]   new session in .claude/worktrees/<task> on branch worktree-<task>,
#                               branched from a freshly fetched origin/master
#   crwn                        same, and Claude picks the name
#   crwn resume <task>          reopen a task worktree you kept
#   crwn ls                     every worktree: branch, ahead/behind master, uncommitted files
#   crwn land <task|branch>     fast-forward the REMOTE master to a finished, reconciled, pushed, built
#                               branch. A task session lands its own with --yes
#   crwn sync                   fast-forward the LOCAL main checkout to origin/master; never touches
#                               uncommitted files (git refuses, and so does this)
#   crwn rm <task>              remove a finished worktree (the branch is kept)
#   crwn clean [--apply]        every task worktree: landed?, dirty?, in use?, disk. A dry run unless
#                               --apply: removes landed+clean+idle worktrees, deletes idle caches
#
# Cleanup also runs on its own, under the same rules: after crwn land (that task only) and when a
# new task starts (every idle worktree). Branches are never deleted.
#
# Worktrees are created by Claude Code's native --worktree; this script only adds the checks
# around it: WSL only (Windows git corrupts this repo's colon-named files), a fresh base, and a
# clear refusal when a task name is already in use.
set -euo pipefail

die() { printf 'crwn: %s\n' "$*" >&2; exit 1; }
[[ "$(uname -s)" == Linux ]] || die "run this inside WSL (from PowerShell: wsl scripts/dev/crwn ...). Windows-side git corrupts this repo."
export PATH="$HOME/.local/bin:$PATH"

# The main checkout, wherever this is run from (a task worktree, or via a ~/.local/bin symlink).
SELF=$(readlink -f "${BASH_SOURCE[0]}")
COMMON=$(git -C "$(dirname "$SELF")" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
  || die "cannot find the CRWN repository from $SELF"
ROOT=$(dirname "$COMMON")
[[ -f "$ROOT/CLAUDE.md" && "$(git -C "$ROOT" remote get-url origin 2>/dev/null)" == *crwn* ]] \
  || die "$ROOT does not look like the CRWN repository"
g() { git -C "$ROOT" "$@"; }
BASE=$(g symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
BASE=${BASE:-master}
WTS="$ROOT/.claude/worktrees"

# Task names become a directory and the branch worktree-<task>: lowercase letters, digits, dashes.
task_name() {
  local raw="$1" t
  t=$(printf '%s' "$raw" | tr '[:upper:]_ ' '[:lower:]--' | tr -cd 'a-z0-9-' | sed -E 's/-+/-/g; s/^-//; s/-$//' | cut -c1-40)
  t=${t%-}
  [[ -n "$t" ]] || die "'$raw' is not a usable task name (use letters, digits and dashes, e.g. manychat-fix)"
  [[ "$t" == "$raw" ]] || printf 'crwn: using task name "%s"\n' "$t" >&2
  printf '%s' "$t"
}

describe() { # one line about an existing task worktree
  local dir="$1" br dirty last
  br=$(git -C "$dir" branch --show-current 2>/dev/null || echo '?')
  dirty=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l)
  last=$(git -C "$dir" log -1 --format='%h %s (%cr)' 2>/dev/null || echo 'no commits')
  printf '%s on %s, %s uncommitted file(s), last commit %s' "$dir" "$br" "$dirty" "$last"
}

in_claude_worktree() { # true inside a Claude session whose cwd is a linked worktree
  [[ -n "${CLAUDECODE:-}" ]] || return 1
  local gd cd
  gd=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null) || return 1
  cd=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [[ "$gd" != "$cd" ]]
}

cmd_new() {
  local task=""
  if [[ $# -gt 0 && "$1" != -* ]]; then task=$(task_name "$1"); shift; fi
  if [[ -n "$task" ]]; then
    [[ -e "$WTS/$task" ]] && die "task '$task' already has a worktree:
  $(describe "$WTS/$task")
If its session is still open in another terminal, pick a different name.
To continue it here: crwn resume $task"
    g show-ref --verify --quiet "refs/heads/worktree-$task" && die "branch worktree-$task already exists (kept from an earlier task).
Pick a different name, or reopen it with: crwn resume $task"
  fi
  # Claude Code only refreshes the base when the repo has not been fetched for 24h. Fetch now so a
  # new task never starts from a stale master (offline: fall back to the cached ref, like Claude).
  g fetch --quiet origin "$BASE" 2>/dev/null || echo "crwn: fetch failed, using cached origin/$BASE" >&2
  g show-ref --verify --quiet "refs/remotes/origin/worktree-$task" 2>/dev/null && [[ -n "$task" ]] \
    && die "origin already has a branch worktree-$task from an earlier task. Pick a different name."
  sweep --no-fetch --no-sizes --quiet   # landed+idle worktrees and idle caches go before a new one arrives
  echo "crwn: base origin/$BASE $(g rev-parse --short "origin/$BASE"), worktree .claude/worktrees/${task:-<named by Claude>}, branch worktree-${task:-<name>}" >&2
  cd "$ROOT"
  if [[ -n "$task" ]]; then exec claude --worktree "$task" "$@"; else exec claude --worktree "$@"; fi
}

cmd_resume() {
  [[ $# -ge 1 ]] || die "usage: crwn resume <task>"
  local task; task=$(task_name "$1"); shift
  if [[ ! -e "$WTS/$task" ]]; then
    if ! g show-ref --verify --quiet "refs/heads/worktree-$task"; then
      # The local branch is gone but origin still has it: recreate it from there, commits intact.
      g fetch --quiet origin "worktree-$task" 2>/dev/null || true
      g show-ref --verify --quiet "refs/remotes/origin/worktree-$task" \
        || die "no worktree or branch for task '$task', here or on origin (see: crwn ls)"
      g branch --quiet --track "worktree-$task" "origin/worktree-$task"
      echo "crwn: recreated branch worktree-$task from origin" >&2
    fi
    g worktree add --quiet "$WTS/$task" "worktree-$task"   # recreate the directory for a kept branch
  fi
  cd "$ROOT"
  exec claude --worktree "$task" --resume "$@"
}

cmd_ls() {
  g fetch --quiet origin "$BASE" 2>/dev/null || true
  printf '%-28s %-34s %-12s %-6s %s\n' TASK BRANCH "vs $BASE" DIRTY PUSHED
  local path br ab dirty pushed
  while read -r key val; do
    case "$key" in
      worktree) path=$val ;;
      branch)
        br=${val#refs/heads/}
        ab=$(g rev-list --left-right --count "origin/$BASE...$br" 2>/dev/null | awk '{print "+"$2" -"$1}')
        dirty=$(git --no-optional-locks -C "$path" status --porcelain 2>/dev/null | wc -l)
        if ! g show-ref --verify --quiet "refs/remotes/origin/$br"; then pushed=no
        elif [[ "$(g rev-parse "$br")" == "$(g rev-parse "origin/$br")" ]]; then pushed=yes
        else pushed=behind-local; fi
        [[ "$path" == "$ROOT" ]] && pushed="(main checkout)"
        printf '%-28s %-34s %-12s %-6s %s\n' "${path#"$WTS/"}" "$br" "$ab" "$dirty" "$pushed" ;;
    esac
  done < <(g worktree list --porcelain)
}

# A path handed to the founder must resolve in the MAIN checkout, because that is what a markdown
# link opens for him. Landing moves ORIGIN, not his checkout, so "it landed" does not make a
# repo-relative link work: it stays broken until `crwn sync`. This prints, for each file, the form
# that opens TODAY, so a hand-off is never written from memory.
# $1: newline-separated repo-relative paths. Reads $ROOT. Prints nothing when there are none.
print_handoff_links() {
  local list="$1" f wt found
  [[ -z "$list" ]] && return 0
  echo
  echo "SQL to hand over. Link it EXACTLY as printed (these resolve from $ROOT right now):"
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    if [[ -e "$ROOT/$f" ]]; then
      echo "  [$f]($f)"
      continue
    fi
    found=""
    for wt in "$ROOT"/.claude/worktrees/*/; do
      [[ -e "$wt$f" ]] || continue
      found=".claude/worktrees/$(basename "$wt")/$f"
      break
    done
    if [[ -n "$found" ]]; then
      echo "  [$found]($found)"
      echo "      (the main checkout does not have this yet; the worktree path opens today)"
    else
      echo "  $f  -- NOT on disk anywhere. Hand it over only after: crwn sync"
    fi
  done <<< "$list"
}

cmd_land() {
  [[ $# -ge 1 ]] || die "usage: crwn land <task|branch> [--yes]"
  local arg="$1" yes=""; shift
  [[ "${1:-}" == "--yes" ]] && yes=1
  local br="$arg"
  g show-ref --verify --quiet "refs/heads/worktree-$arg" && br="worktree-$arg"
  g show-ref --verify --quiet "refs/heads/$br" || die "no local branch '$arg' or 'worktree-$arg'"
  local dir; dir=$(g worktree list --porcelain | awk -v b="branch refs/heads/$br" '/^worktree /{p=$2} $0==b{print p}')
  if [[ -n "$dir" && "$(git -C "$dir" status --porcelain | wc -l)" -ne 0 ]]; then
    die "$br has uncommitted changes in $dir. The task is not finished: commit (or drop) them in that session first."
  fi
  g fetch --quiet origin "$BASE" "$br" 2>/dev/null || die "fetch failed; is $br pushed? (in the task: git push -u origin HEAD)"
  local tip; tip=$(g rev-parse "$br")
  [[ "$tip" == "$(g rev-parse "origin/$br")" ]] || die "$br is not pushed as-is (local $(g rev-parse --short "$br"), origin $(g rev-parse --short "origin/$br")). Push it from the task first."
  local behind ahead
  behind=$(g rev-list --count "$tip..origin/$BASE")
  ahead=$(g rev-list --count "origin/$BASE..$tip")
  [[ "$ahead" -gt 0 ]] || die "$br has nothing $BASE does not already have."
  [[ "$behind" -eq 0 ]] || die "$br is $behind commit(s) behind $BASE. Reconcile it in the task session first:
  git fetch origin && git merge origin/$BASE   (resolve conflicts, rerun tests/build, push)
then run: crwn land $arg"
  # A task session lands its own branch (founder, 2026-10-02), so the proof that it builds lives
  # here instead of in a human reading the diff: a change that reaches the app needs a production
  # build that finished AFTER the branch's last commit, in that clean worktree. Docs, hooks, dev
  # tooling and video assets do not feed next build, so a change to only those skips the check.
  local app; app=$(g diff --name-only "origin/$BASE..$tip" | grep -v -E '(\.md$|^docs/|^\.claude/|^scripts/dev/|^videos/)' || true)
  if [[ -n "$app" ]]; then
    [[ -n "$dir" ]] || die "$br changes the app but has no worktree here, so there is no build to check. Land it from its worktree after npm run build."
    local bid="$dir/.next/BUILD_ID"
    [[ -f "$bid" ]] || die "$br changes the app and $dir has no .next/BUILD_ID. Run npm run build there (inside WSL) first."
    [[ "$(stat -c %Y "$bid")" -ge "$(g log -1 --format=%ct "$tip")" ]] \
      || die "$br's last build is older than its last commit. Rerun npm run build in $dir, then land."
  fi
  echo "Landing $br ($ahead commit(s)) onto $BASE as a fast-forward:"
  g log --oneline "origin/$BASE..$tip" | sed 's/^/  /'
  g diff --stat "origin/$BASE..$tip" | tail -1 | sed 's/^/  /'
  local dels; dels=$(g diff --diff-filter=D --name-only "origin/$BASE..$tip")
  # Files the founder has to OPEN after this lands (migrations and one-off SQL). Captured here,
  # before the push, because afterwards origin/$BASE is $tip and this diff is empty.
  local handoff; handoff=$(g diff --diff-filter=AM --name-only "origin/$BASE..$tip" -- 'supabase/*.sql')
  [[ -n "$dels" ]] && { echo "  FILES THIS DELETES:"; printf '%s\n' "$dels" | sed 's/^/    /'; }
  if [[ -z "$yes" ]]; then
    [[ -t 0 ]] || die "not a terminal; re-run with --yes to confirm"
    read -r -p "Push $(g rev-parse --short "$tip") to origin/$BASE (production deploys from $BASE)? [y/N] " ok
    [[ "$ok" == y || "$ok" == Y ]] || die "not landed"
  fi
  # A plain push of a descendant: git and GitHub reject it unless it is a fast-forward, so a master
  # that moved since the fetch above fails loudly instead of being overwritten. Never --force.
  g push origin "$tip:refs/heads/$BASE"
  echo "Landed: the REMOTE origin/$BASE is now $(g rev-parse --short "$tip") (production deploys from it)."
  # Bring the founder's own checkout to what just landed, so a path I hand him actually opens and
  # he never has to run anything to see his own repo. Non-fatal: the land already succeeded.
  echo "Main checkout:"
  sync_main_checkout || true
  print_handoff_links "$handoff"
  # Remove that task's worktree now if it is clean and idle. Otherwise this says what keeps it
  # (usually its session is still open), and the next sweep removes it. Run from inside the
  # landed worktree, its own session is the one running, so it is kept for the next sweep.
  if [[ -n "$dir" && "$PWD/" == "$dir/"* ]]; then
    echo "Keeping $dir (this ran from inside it). The next crwn clean removes it once idle."
  else
    sweep --no-fetch --only "${arg#worktree-}"
  fi
}

# Fast-forward the LOCAL main checkout to origin/$BASE. SAFE BY CONSTRUCTION: every unsafe case
# refuses and changes nothing, and a success never touches uncommitted work. Echoes what happened
# and returns non-zero instead of dying, so `land` can call it without ever failing a land.
#
# WHY LAND CALLS THIS (founder, 2026-10-02). Landing moves ORIGIN, not this checkout, so the
# founder was left running `crwn sync` by hand to see his own repo. That is the same overhead the
# self-landing rule removed, wearing a different hat: a migration I handed him would not open,
# because the file existed on origin and not on his disk. A task session updating the main checkout
# used to be forbidden, and the reason was protecting another session's work. That reason is
# already covered here: a modified or staged file makes git refuse the fast-forward, an ignored
# file that master starts tracking is caught below, and uncommitted work is left exactly as it was.
sync_main_checkout() {
  local cur; cur=$(g branch --show-current)
  [[ "$cur" == "$BASE" ]] || { echo "  main checkout is on '$cur', not $BASE. Not touching it."; return 1; }
  g fetch --quiet origin "$BASE" || { echo "  fetch failed; main checkout not updated."; return 1; }
  local ahead behind
  ahead=$(g rev-list --count "origin/$BASE..HEAD"); behind=$(g rev-list --count "HEAD..origin/$BASE")
  [[ "$ahead" -eq 0 ]] || { echo "  main checkout has $ahead commit(s) not on origin. Push or land them first; nothing changed."; return 1; }
  [[ "$behind" -gt 0 ]] || { echo "  main checkout is already current."; return 0; }
  # git refuses by itself to overwrite a modified tracked file or an untracked one. It does NOT
  # refuse to overwrite an IGNORED file that master starts tracking (.env* is ignored), so check that.
  local hit="" f
  while IFS= read -r f; do [[ -n "$f" && -e "$ROOT/$f" ]] && hit+="    $f"$'\n'; done < <(g diff --name-only --diff-filter=A HEAD "origin/$BASE")
  [[ -z "$hit" ]] || { echo "  these files exist locally and $BASE now tracks them. Move them yourself; nothing changed:"; printf '%s' "$hit"; return 1; }
  local dirty; dirty=$(g status --porcelain | wc -l)
  if g merge --ff-only --quiet "origin/$BASE"; then
    echo "  main checkout moved to $(g rev-parse --short HEAD) (+$behind commit(s)). Your $dirty uncommitted file(s) are untouched."
    return 0
  fi
  echo "  git refused the fast-forward because it would overwrite uncommitted work. Nothing changed."
  echo "  Finish or move those files, then: crwn sync"
  return 1
}

cmd_sync() { # fast-forward the LOCAL main checkout to origin/$BASE, never touching uncommitted work
  sync_main_checkout || die "the main checkout was not updated (reason above)."
}

# The cleanup engine (scripts/dev/worktree-clean.mjs) run by land and new. Never fails the caller.
sweep() {
  command -v node >/dev/null 2>&1 || { echo "crwn: node not found, cleanup skipped" >&2; return 0; }
  node "$ROOT/scripts/dev/worktree-clean.mjs" --repo "$ROOT" --apply "$@" || echo "crwn: cleanup skipped (see above)" >&2
}

cmd_clean() {
  [[ " $* " == *" --apply "* ]] && in_claude_worktree \
    && die "a task session never cleans up other checkouts. Run crwn clean --apply from the main checkout or a plain terminal."
  command -v node >/dev/null 2>&1 || die "node not found"
  exec node "$ROOT/scripts/dev/worktree-clean.mjs" --repo "$ROOT" "$@"
}

cmd_rm() {
  [[ $# -ge 1 ]] || die "usage: crwn rm <task>"
  local task; task=$(task_name "$1")
  local dir="$WTS/$task"
  [[ -d "$dir" ]] || die "no worktree for task '$task' (see: crwn ls)"
  local br; br=$(git -C "$dir" branch --show-current)
  local lock="$COMMON/worktrees/$task/locked"
  if [[ -f "$lock" ]]; then
    local pid; pid=$(grep -o 'pid [0-9]*' "$lock" | awk '{print $2}')
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      die "task '$task' is locked by a Claude session that is still running (pid $pid). Exit that session first."
    fi
    g worktree unlock "$dir"   # stale lock from a session that has exited
  fi
  # No --force: git refuses a worktree with uncommitted or untracked work, which is the point.
  g worktree remove "$dir" || die "not removed. Commit or discard the work in $dir first (crwn never forces this)."
  local state="not pushed"
  g show-ref --verify --quiet "refs/remotes/origin/$br" && state="pushed"
  g merge-base --is-ancestor "$br" "origin/$BASE" 2>/dev/null && state="$state, landed in $BASE"
  echo "Removed .claude/worktrees/$task. Branch $br is kept ($state)."
  [[ "$state" == *landed* ]] && echo "It is fully landed; delete it when you like: git branch -d $br"
  return 0
}

case "${1:-}" in
  -h|--help|help) sed -n '2,20p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  clean) shift; cmd_clean "$@" ;;
  ls|list) shift; cmd_ls "$@" ;;
  land) shift; cmd_land "$@" ;;
  sync) shift; cmd_sync "$@" ;;
  rm|remove) shift; cmd_rm "$@" ;;
  resume) shift; cmd_resume "$@" ;;
  *) cmd_new "$@" ;;
esac
